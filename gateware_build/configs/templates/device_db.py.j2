# Generated from {{ source_config }}
# Source of truth: experiment YAML.

device_db = {
    "core": {
        "type": "local",
        "module": "artiq.coredevice.core",
        "class": "Core",
        "arguments": {"host": "{{ core_host }}", "ref_period": 1e-9},
    },
    "core_log": {
        "type": "controller",
        "host": "::1",
        "port": 1068,
        "command": "aqctl_corelog -p {port} --bind {bind} {{ core_host }}",
    },
    "entangler": {
        "type": "local",
{% if cfg.target.variant == "and_nand_test" or cfg.experiment.name == "and_nand_test" %}
        "module": "entangler.and_nand_test_driver",
        "class": "AndNandTestEntangler",
        "arguments": {"channel": 0},
{% elif cfg.repositories.entangler_core_branch == "feature/atom-photon-parity" or cfg.repositories.entangler_core_branch == "feature/atom-photon-parity-gateware-redesign" %}
        "module": "entangler.atom_photon_parity_driver",
        "class": "AtomPhotonParityEntangler",
        "arguments": {"channel": 0},
{% else %}
        "module": "entangler.driver",
        "class": "Entangler",
        "arguments": {
            "num_inputs": {{ cfg.entangler.num_inputs }},
            "num_outputs": {{ cfg.entangler.num_outputs }},
            "coincidence_window_mu": {{ cfg.entangler.coincidence_window_mu }},
            "timeout_mu": {{ cfg.entangler.timeout_mu }},
            "fast_branch": {{ cfg.entangler.fast_branch }},
        },
{% endif %}
    },
{% for pad in cfg.hardware.input_pads %}
    "entangler_input{{ loop.index0 }}": {
        "type": "local",
        "module": "artiq.coredevice.ttl",
        "class": "TTLInOut",
        "arguments": {"channel": "{{ pad }}", "dio_eem": {{ cfg.hardware.dio_eem }}},
    },
{% endfor %}
{% for pad in cfg.hardware.output_pads %}
    "entangler_output{{ loop.index0 }}": {
        "type": "local",
        "module": "artiq.coredevice.ttl",
        "class": "TTLOut",
        "arguments": {"channel": "{{ pad }}", "dio_eem": {{ cfg.hardware.dio_eem }}},
    },
{% endfor %}
}
